{
    "name": "bewil19/sitetemplate",
    "description": "My sitetemplate for all my sites.",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "league/plates": "*"
    },
    "autoload": {
        "psr-4": {
            "bewil19\\Site\\": "src"
        }
    },
    "require-dev": {
        "rector/rector": "*",
        "friendsofphp/php-cs-fixer": "*"
    },
    "scripts": {
        "cs": ["./vendor/bin/php-cs-fixer fix"]
    },
    "bin": [
        "bin/sitetemplate"
    ]
}
